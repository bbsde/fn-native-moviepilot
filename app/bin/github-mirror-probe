#!/bin/bash
#
# github-mirror-probe — 探测可用的 GitHub 加速镜像，输出最优镜像的"完整前缀"
#
# 用法：GITHUB_PREFIX=$(github-mirror-probe [mode])
#   mode = git   : 用 git ls-remote 探测（用于 git clone/pull）
#   mode = curl  : 用 curl -sI 探测（用于 curl 下载 release/archive）
#   mode 默认 curl
#
# 输出（stdout）：可用镜像的完整前缀 URL（拼接好 github.com 的形式），
#                 形如 https://v4.gh-proxy.org/https://github.com
#                 所有镜像都不可用时输出空串，调用方应回退直连。
#
# 完整前缀格式说明：调用方把它拼在 github 仓库路径前即可。
#   git insteadOf:  url.<GITHUB_PREFIX>/.insteadOf = https://github.com/
#   curl 直拼:      <GITHUB_PREFIX>/jxxghp/MoviePilot/...

MODE="${1:-curl}"
# 探测目标：一个轻量的 github 仓库引用查询（git）或 release 页（curl）
PROBE_REPO="jxxghp/MoviePilot.git"
TIMEOUT=10

# 候选镜像（顺序即优先级）。每行：<完整前缀>
# 完整前缀 = 拼好 https://github.com 的形式，调用方直接用。
MIRRORS=(
    "https://v4.gh-proxy.org/https://github.com"
    "https://hk.gh-proxy.org/https://github.com"
    "https://wget.la/https://github.com"
    "https://gitclone.com/github.com"
)

probe_git() {
    local prefix="$1"
    # git ls-remote --heads 只取引用列表，流量极小，足以判断连通性
    timeout "${TIMEOUT}" git ls-remote --heads "${prefix}/${PROBE_REPO}" >/dev/null 2>&1
}

probe_curl() {
    local prefix="$1"
    # 探测一个真实的小文件下载（raw 文件，镜像站都支持 raw 代理）
    # 用 version.py（几十字节），HEAD 请求不下载 body
    local url="${prefix}/jxxghp/MoviePilot/raw/refs/heads/v2/version.py"
    local code
    code=$(timeout "${TIMEOUT}" curl -s -o /dev/null -w "%{http_code}" -L "${url}" 2>/dev/null)
    [ "${code}" = "200" ]
}

for prefix in "${MIRRORS[@]}"; do
    case "${MODE}" in
        git)  probe_git "${prefix}" && { printf '%s\n' "${prefix}"; exit 0; } ;;
        *)    probe_curl "${prefix}" && { printf '%s\n' "${prefix}"; exit 0; } ;;
    esac
done

# 全部不可用：输出空串
exit 0
