#!/bin/bash
#
# config_callback — 配置变更后调用（privilege run-as: root 下为 root 身份）
#
# 触发源（trim_app_center，实测两种）：
#   1) 应用设置面板提交（wizard/config 表单值以 wizard_* 环境变量传入）
#   2) 「配置访问权限」变更——授权清单以 TRIM_DATA_ACCESSIBLE_PATHS（冒号
#      分隔）传入，config_init 拿旧值、config_callback 拿新值
#
# 处理：
#   1) 网桥免登录账号绑定（wizard_superuser / wizard_password → app.env）
#   2) 授权目录祖先链浏览可见性（见 sync_browse_visibility）
#
#   留空语义：wizard 字段留空 = 不修改当前值（保留 app.env 现有内容）。

set -uo pipefail

# ===== fnOS 运行上下文 =====
APP_DEST="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"
HOME_DIR="${TRIM_PKGHOME}"
APP_USER="${TRIM_USERNAME:-moviepilot}"
APP_GROUP="${TRIM_GROUPNAME:-moviepilot}"

CONFIG_LOG="${DATA_DIR}/config.log"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $*" | tee -a "${CONFIG_LOG}" 2>/dev/null || \
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $*"
}

# 从共享区定位 config 目录（与 install_callback / main 一致）
resolve_config_dir() {
    local paths="${TRIM_DATA_SHARE_PATHS:-}"
    local p
    if [ -n "${paths}" ]; then
        local IFS=':'
        for p in ${paths}; do
            if [ -n "${p}" ] && echo "${p}" | grep -Eq '/config/?$'; then
                echo "${p}"
                return 0
            fi
        done
    fi
    [ -d "/var/apps/moviepilot/share/config" ] && { echo "/var/apps/moviepilot/share/config"; return 0; }
    return 1
}

# 最小 KEY=VALUE 写入：已存在则替换该行，不存在则追加。
# 不引入依赖，app.env 结构简单（每行一个 KEY=VALUE）。
write_env_key() {
    local file="$1" key="$2" val="$3"
    local escaped_val
    # 转义特殊字符对 sed 替换的影响：用 | 做 sed 分隔符，转义 | 和 &
    escaped_val="$(printf '%s' "${val}" | sed 's/[&|]/\\&/g')"
    if grep -qE "^[[:space:]]*${key}=" "${file}"; then
        # 已存在：替换该行（保留行尾可能的注释由用户自行管理，这里整行替换）
        sed -i -E "s|^[[:space:]]*${key}=.*|${key}=${escaped_val}|" "${file}"
    else
        # 不存在：追加（确保上一行有换行）
        [ -s "${file}" ] && [ "$(tail -c1 "${file}" 2>/dev/null)" != $'\n' ] && printf '\n' >> "${file}"
        printf '%s=%s\n' "${key}" "${val}" >> "${file}"
    fi
}

# --------------------------------------------------------------------------
# 应用免登录账号变更
# --------------------------------------------------------------------------
setup_bridge_autologin() {
    local wizard_user="${wizard_superuser:-}"
    local wizard_pass="${wizard_password:-}"

    # 都留空 → 用户未修改，跳过
    if [ -z "${wizard_user}" ] && [ -z "${wizard_pass}" ]; then
        log "免登录配置未修改（用户名密码均留空），跳过"
        return 0
    fi

    local config_dir env_file
    config_dir="$(resolve_config_dir 2>/dev/null)" || {
        log "[WARN] 无法定位 config 目录，免登录配置未更新"
        return 0
    }
    env_file="${config_dir}/app.env"
    if [ ! -f "${env_file}" ]; then
        log "[WARN] app.env 不存在（${env_file}），免登录配置未更新"
        return 0
    fi

    local changed=0
    if [ -n "${wizard_user}" ]; then
        write_env_key "${env_file}" "SUPERUSER" "${wizard_user}"
        changed=1
        log "免登录用户名已更新：${wizard_user}"
    fi
    if [ -n "${wizard_pass}" ]; then
        write_env_key "${env_file}" "SUPERUSER_PASSWORD" "${wizard_pass}"
        changed=1
        log "免登录密码已更新"
    fi

    if [ "${changed}" -eq 1 ]; then
        # 改属主：app.env 在共享区，需 moviepilot 用户可读（桥经 cmd/main 以该用户跑）
        chown "${APP_USER}:${APP_GROUP}" "${env_file}" 2>/dev/null || \
            log "[WARN] chown ${env_file} 失败"
        chmod 600 "${env_file}" 2>/dev/null || true  # 含密码，收紧权限
        log "app.env 已更新，触发应用重启使免登录新凭证生效 ..."
    fi
    return 0
}

# --------------------------------------------------------------------------
# 重启应用（让 cmd/main 重新拉起，桥重新读 app.env 凭据）
# config_callback 以 root 跑，cmd/main 需以应用用户身份执行（main 内部 prepare_env
# 会切到正确的 PATH/HOME）。用 runuser 切换到 APP_USER 调 main stop/start。
# 注意：cmd/ 位于应用根目录（/var/apps/<appname>/cmd），不在 target 下
# （TRIM_APPDEST 指向 target），此处逐候选解析。
# --------------------------------------------------------------------------
restart_app() {
    local main_script=""
    local cand
    for cand in "/var/apps/moviepilot/cmd/main" \
                "${TRIM_APPDEST%/target}/cmd/main" \
                "${APP_DEST}/cmd/main"; do
        if [ -x "${cand}" ]; then
            main_script="${cand}"
            break
        fi
    done
    [ -n "${main_script}" ] || {
        log "[WARN] 未找到可执行的 cmd/main，请手动重启应用"
        return 0
    }

    log "重启应用（stop → start）..."
    # runuser 切到应用用户，注入 fnOS 上下文变量（main 依赖 TRIM_* 系列）
    # 这些变量在 config_callback 环境里已有，runuser 默认清环境，需显式传入。
    runuser -u "${APP_USER}" -- env \
        TRIM_APPDEST="${TRIM_APPDEST}" \
        TRIM_PKGVAR="${TRIM_PKGVAR}" \
        TRIM_PKGHOME="${TRIM_PKGHOME}" \
        TRIM_DATA_SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}" \
        TRIM_USERNAME="${APP_USER}" \
        TRIM_GROUPNAME="${APP_GROUP}" \
        TRIM_TEMP_LOGFILE="${TRIM_TEMP_LOGFILE:-}" \
        PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        bash "${main_script}" stop >> "${CONFIG_LOG}" 2>&1 || \
        log "[WARN] stop 返回非零（可能本就没在跑），继续 start"

    sleep 2

    runuser -u "${APP_USER}" -- env \
        TRIM_APPDEST="${TRIM_APPDEST}" \
        TRIM_PKGVAR="${TRIM_PKGVAR}" \
        TRIM_PKGHOME="${TRIM_PKGHOME}" \
        TRIM_DATA_SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}" \
        TRIM_USERNAME="${APP_USER}" \
        TRIM_GROUPNAME="${APP_GROUP}" \
        TRIM_TEMP_LOGFILE="${TRIM_TEMP_LOGFILE:-}" \
        PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        bash "${main_script}" start >> "${CONFIG_LOG}" 2>&1 || {
        log "[ERROR] 应用重启失败，请手动在应用中心启动"
        return 0
    }
    log "应用已重启，配置已生效"
}

# 自动更新开关已随 v3 打包设计移除：在线更新会用上游原版文件覆盖构建期补丁，
# 且 venv 依赖按 payload.lock 装配、与新版源码脱钩。唯一更新通道 = 安装新 fpk；
# cmd/main 启动时无条件强制 MOVIEPILOT_AUTO_UPDATE=false（含网页内勾选）。


# --------------------------------------------------------------------------
# 授权目录祖先链浏览可见性（TRIM_DATA_ACCESSIBLE_PATHS）
#   fnOS「配置访问权限」对目标目录授读写（trim_acl 内核层生效），但祖先层
#   仅给穿透（--x）不可列举 → 网页目录浏览器在 /volN 层即无法展开。
#   此处为每条授权目录的祖先链补 r-x：浏览器可逐级点到授权目录；授权范围
#   之外的内容依旧不可读。幂等；祖先路径记录至 browse_grants.txt 供卸载回收。
#   非 root 上下文（异常场景）则跳过，交由下次安装/升级兜底同步。
# --------------------------------------------------------------------------
sync_browse_visibility() {
    local dirs="${TRIM_DATA_ACCESSIBLE_PATHS:-}"
    if [ -z "${dirs}" ]; then
        return 0
    fi
    if [ "$(id -un)" != "root" ]; then
        log "[WARN] 非特权上下文，浏览层同步跳过（下次安装/升级兜底）"
        return 0
    fi

    local config_dir granted_file
    config_dir="$(resolve_config_dir 2>/dev/null)" || return 0
    granted_file="${config_dir}/browse_grants.txt"
    touch "${granted_file}" 2>/dev/null || return 0

    local d p n=0
    local IFS=':'
    for d in ${dirs}; do
        [ -d "${d}" ] || continue
        p="${d%/}"
        while [ "${#p}" -gt 1 ]; do
            p="${p%/*}"
            [ -z "${p}" ] && p="/"
            case "${p}" in ""|"/") break ;; esac
            setfacl -m "u:${APP_USER}:r-x" "${p}" 2>/dev/null || true
            grep -qxF "${p}" "${granted_file}" 2>/dev/null || echo "${p}" >> "${granted_file}"
            n=$((n + 1))
        done
    done
    chown "${APP_USER}:${APP_GROUP}" "${granted_file}" 2>/dev/null || true
    log "授权目录祖先链浏览可见性已同步（${n} 条 r-x）"
}

log "=== 应用配置变更 ==="
sync_browse_visibility
setup_bridge_autologin
# 配置改了 app.env → 重启让后端/桥重读
if [ -n "${wizard_superuser:-}${wizard_password:-}" ]; then
    restart_app
fi
log "=== 配置应用完成 ==="
exit 0
