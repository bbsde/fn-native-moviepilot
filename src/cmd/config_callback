#!/bin/bash
#
# config_callback — 配置变更后调用（privilege run-as: root 下为 root 身份）
#
# 触发源（trim_app_center，实测两种）：
#   1) 应用设置面板提交（wizard/config 表单值以 wizard_* 环境变量传入）
#   2) 「配置访问权限」变更——授权清单以 TRIM_DATA_ACCESSIBLE_PATHS（冒号
#      分隔）传入，config_init 拿旧值、config_callback 拿新值
#
# 处理：
#   1) 网桥免登录账号绑定（wizard_superuser / wizard_password → app.env）
#   2) 授权目录清单落盘（见 write_fnos_grants → fnos_grants.txt，
#      MP 目录浏览器补丁据此在祖先层合成下一跳虚拟目录）
#
#   留空语义：wizard 字段留空 = 不修改当前值（保留 app.env 现有内容）。
#
#   值未变化时不动应用：fnOS 配置回调会把面板存量的向导字段原样回传
#   （如「配置访问权限」变更触发的钩子），非空 ≠ 用户改了值，必须比对。
#   真变化时也只重启网关桥（restart-bridge，秒级），MoviePilot 前后端
#   不读这两个字段，无需全量重启。

set -uo pipefail

# ===== fnOS 运行上下文 =====
APP_DEST="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"
HOME_DIR="${TRIM_PKGHOME}"
APP_USER="${TRIM_USERNAME:-moviepilot}"
APP_GROUP="${TRIM_GROUPNAME:-moviepilot}"

CONFIG_LOG="${DATA_DIR}/config.log"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $*" | tee -a "${CONFIG_LOG}" 2>/dev/null || \
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $*"
}

# 从共享区定位 config 目录（与 install_callback / main 一致）
resolve_config_dir() {
    local paths="${TRIM_DATA_SHARE_PATHS:-}"
    local p
    if [ -n "${paths}" ]; then
        local IFS=':'
        for p in ${paths}; do
            if [ -n "${p}" ] && echo "${p}" | grep -Eq '/config/?$'; then
                echo "${p}"
                return 0
            fi
        done
    fi
    [ -d "/var/apps/moviepilot/share/config" ] && { echo "/var/apps/moviepilot/share/config"; return 0; }
    return 1
}

# 最小 KEY=VALUE 写入：已存在则替换该行，不存在则追加。
# 不引入依赖，app.env 结构简单（每行一个 KEY=VALUE）。
write_env_key() {
    local file="$1" key="$2" val="$3"
    local escaped_val
    # 转义特殊字符对 sed 替换的影响：用 | 做 sed 分隔符，转义 | 和 &
    escaped_val="$(printf '%s' "${val}" | sed 's/[&|]/\\&/g')"
    if grep -qE "^[[:space:]]*${key}=" "${file}"; then
        # 已存在：替换该行（保留行尾可能的注释由用户自行管理，这里整行替换）
        sed -i -E "s|^[[:space:]]*${key}=.*|${key}=${escaped_val}|" "${file}"
    else
        # 不存在：追加（确保上一行有换行）
        [ -s "${file}" ] && [ "$(tail -c1 "${file}" 2>/dev/null)" != $'\n' ] && printf '\n' >> "${file}"
        printf '%s=%s\n' "${key}" "${val}" >> "${file}"
    fi
}

# 从 app.env 读指定 key 当前值（与 cmd/main 的 read_env_key 同款最小解析）
read_env_key() {
    local key="$1" env_file="$2"
    [ -f "${env_file}" ] || return 1
    awk -F= -v k="${key}" '
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        $1 == k {
            v = substr($0, index($0, "=") + 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
            if (v ~ /^".*"$/ || v ~ /^'"'"'.*'"'"'$/) v = substr(v, 2, length(v) - 2)
            print v
            exit
        }
    ' "${env_file}"
}

# --------------------------------------------------------------------------
# 应用免登录账号变更（先比对现值，仅实际变化才写）
# --------------------------------------------------------------------------
setup_bridge_autologin() {
    local wizard_user="${wizard_superuser:-}"
    local wizard_pass="${wizard_password:-}"

    # 都留空 → 用户未修改，跳过
    if [ -z "${wizard_user}" ] && [ -z "${wizard_pass}" ]; then
        log "免登录配置未修改（用户名密码均留空），跳过"
        return 0
    fi

    local config_dir env_file
    config_dir="$(resolve_config_dir 2>/dev/null)" || {
        log "[WARN] 无法定位 config 目录，免登录配置未更新"
        return 0
    }
    env_file="${config_dir}/app.env"
    if [ ! -f "${env_file}" ]; then
        log "[WARN] app.env 不存在（${env_file}），免登录配置未更新"
        return 0
    fi

    # 与现值比对：回传的存量值与 app.env 一致 → 什么都不做（授权类钩子
    # 触发的回调走这条路，应用保持完全无感）
    local changed=0
    if [ -n "${wizard_user}" ] && [ "${wizard_user}" != "$(read_env_key SUPERUSER "${env_file}")" ]; then
        write_env_key "${env_file}" "SUPERUSER" "${wizard_user}"
        changed=1
        log "免登录用户名已更新：${wizard_user}"
    fi
    if [ -n "${wizard_pass}" ] && [ "${wizard_pass}" != "$(read_env_key SUPERUSER_PASSWORD "${env_file}")" ]; then
        write_env_key "${env_file}" "SUPERUSER_PASSWORD" "${wizard_pass}"
        changed=1
        log "免登录密码已更新"
    fi
    if [ "${changed}" -eq 0 ]; then
        log "免登录凭据与当前值一致，无需更新"
        return 0
    fi

    # 改属主：app.env 在共享区，需 moviepilot 用户可读（桥经 cmd/main 以该用户跑）
    chown "${APP_USER}:${APP_GROUP}" "${env_file}" 2>/dev/null || \
        log "[WARN] chown ${env_file} 失败"
    chmod 600 "${env_file}" 2>/dev/null || true  # 含密码，收紧权限
    log "app.env 已更新（免登录凭据）"
    AUTOLOGIN_CHANGED=1
    return 0
}

# --------------------------------------------------------------------------
# 重启网关桥（仅桥，不动 MoviePilot 前后端）
#   免登录凭据是桥进程启动时从环境读入的（app.env → cmd/main 注入），运行中
#   不会自更新，真变化后只需重启桥（秒级、网页瞬断）。SUPERUSER_PASSWORD
#   仅桥登录用，MP 后端密码在数据库，整个应用无需重启。
#   注意：cmd/ 位于应用根目录（/var/apps/<appname>/cmd），不在 target 下
#   （TRIM_APPDEST 指向 target），此处逐候选解析。
# --------------------------------------------------------------------------
restart_bridge() {
    local main_script=""
    local cand
    for cand in "/var/apps/moviepilot/cmd/main" \
                "${TRIM_APPDEST%/target}/cmd/main" \
                "${APP_DEST}/cmd/main"; do
        if [ -x "${cand}" ]; then
            main_script="${cand}"
            break
        fi
    done
    [ -n "${main_script}" ] || {
        log "[WARN] 未找到可执行的 cmd/main，桥未重启（下次应用启动时生效）"
        return 0
    }
    log "重启网关桥使新凭据生效 ..."
    # config_callback 以 root 运行，TRIM_* 环境直接继承；main 在 root 上下文
    # 内部自行降权（桥经 setpriv），无需此处切换用户。
    bash "${main_script}" restart-bridge >> "${CONFIG_LOG}" 2>&1 || {
        log "[ERROR] 网关桥重启失败，详见 gateway-bridge.log（下次应用启动时兜底）"
        return 0
    }
    log "网关桥已重启，免登录新凭据已生效"
}

# 自动更新开关已随 v3 打包设计移除：在线更新会用上游原版文件覆盖构建期补丁，
# 且 venv 依赖按 payload.lock 装配、与新版源码脱钩。唯一更新通道 = 安装新 fpk；
# cmd/main 启动时无条件强制 MOVIEPILOT_AUTO_UPDATE=false（含网页内勾选）。


# --------------------------------------------------------------------------
# 授权目录清单（TRIM_DATA_ACCESSIBLE_PATHS → fnos_grants.txt）
#   fnOS trimacl 卷上 posix ACL 不被内核执行，祖先层授不了列举权（setfacl
#   写得进、不生效）；改由 MP 目录浏览器补丁读取本清单，在祖先层合成
#   下一跳虚拟目录，逐级展开到授权目录本体（其内为「配置访问权限」原生
#   读写）。清单缺省（普通配置表单提交）时不动现有文件。幂等：整文件重写。
# --------------------------------------------------------------------------
write_fnos_grants() {
    local dirs="${TRIM_DATA_ACCESSIBLE_PATHS:-}"
    [ -z "${dirs}" ] && return 0
    local config_dir grants_file
    config_dir="$(resolve_config_dir 2>/dev/null)" || return 0
    grants_file="${config_dir}/fnos_grants.txt"
    : > "${grants_file}" 2>/dev/null || return 0
    local d
    local IFS=':'
    for d in ${dirs}; do
        [ -d "${d}" ] && echo "${d%/}" >> "${grants_file}"
    done
    chown "${APP_USER}:${APP_GROUP}" "${grants_file}" 2>/dev/null || true
    log "授权目录清单已更新（$(grep -c . "${grants_file}") 条，目录浏览器可逐级展开）"
    return 0
}

log "=== 应用配置变更 ==="
write_fnos_grants
setup_bridge_autologin
# 免登录凭据真的变了 → 仅重启网关桥重读凭据（MoviePilot 本体不动）
[ "${AUTOLOGIN_CHANGED:-0}" = "1" ] && restart_bridge
log "=== 配置应用完成 ==="
exit 0
