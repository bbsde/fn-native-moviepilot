#!/bin/bash
#
# uninstall_callback — 卸载后执行
#
# 作用：停止残留进程，清理程序本体（源码/venv/前端）。
# 共享区 @appshare/moviepilot 下的用户数据（config、数据库）由 fnOS 卸载流程
#       按用户选择处理，本脚本不主动删除，避免误删用户数据。

set -uo pipefail

DATA_DIR="${TRIM_PKGVAR:-}"
APP_DEST="${TRIM_APPDEST:-}"
MP_ROOT="${DATA_DIR}/MoviePilot"
# nodejs_v24（fnOS 应用中心依赖，卸载本应用不清理它）
NODE_RUNTIME_BIN="/var/apps/nodejs_v24/target/bin"
INSTALL_LOG="${DATA_DIR}/install.log"
GATEWAY_PID="${DATA_DIR}/gateway-bridge.pid"
GATEWAY_SOCK="${APP_DEST}/app.sock"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') | [UNINSTALL] $*" | tee -a "${INSTALL_LOG}" 2>/dev/null || \
    echo "$(date '+%Y-%m-%d %H:%M:%S') | [UNINSTALL] $*"
}

# 停止网关桥（卸载前 fnOS 通常已 stop→do_stop 会停桥，这里兜底处理残留）
if [ -f "${GATEWAY_PID}" ]; then
    gpid="$(cat "${GATEWAY_PID}" 2>/dev/null)"
    if [ -n "${gpid}" ] && kill -0 "${gpid}" 2>/dev/null; then
        log "停止网关桥 (pid=${gpid}) ..."
        kill -TERM "${gpid}" 2>/dev/null || true
        sleep 1
        kill -0 "${gpid}" 2>/dev/null && kill -KILL "${gpid}" 2>/dev/null || true
    fi
    rm -f "${GATEWAY_PID}"
fi
rm -f "${GATEWAY_SOCK}"

# 停止 MoviePilot 进程（卸载前 fnOS 通常已 stop，这里做兜底）
if [ -x "${MP_ROOT}/moviepilot" ]; then
    log "停止 MoviePilot ..."
    export PATH="${NODE_RUNTIME_BIN}:${PATH}"
    ( cd "${MP_ROOT}" && ./moviepilot stop --timeout 30 ) >> "${INSTALL_LOG:-/dev/null}" 2>&1 || true
fi

# 清理程序本体（venv、源码、前端缓存），保留共享区用户数据
if [ -d "${MP_ROOT}" ]; then
    log "清理程序目录：${MP_ROOT}"
    rm -rf "${MP_ROOT}"
fi

# --------------------------------------------------------------------------
# 清理授权相关文件与历史 ACL 残留
#   fnos_grants.txt：目录浏览器虚拟路径补丁的授权清单（应用已卸载即无用）
#   browse_grants.txt：≤3.0.0.12 写入的祖先链 posix ACL 记录（trimacl 卷上
#   本就不生效，逐条移除命名条目防误导）。共享区若已被 fnOS 删除则跳过。
# --------------------------------------------------------------------------
revoke_browse_grants() {
    local paths="${TRIM_DATA_SHARE_PATHS:-}" p config_dir=""
    if [ -n "${paths}" ]; then
        local IFS=':'
        for p in ${paths}; do
            if [ -n "${p}" ] && echo "${p}" | grep -Eq '/config/?$'; then
                config_dir="${p}"
                break
            fi
        done
    fi
    [ -n "${config_dir}" ] || return 0
    rm -f "${config_dir}/fnos_grants.txt"
    local granted_file="${config_dir}/browse_grants.txt"
    [ -f "${granted_file}" ] || return 0
    log "清理历史浏览层 ACL 记录 ..."
    local app_user="${TRIM_USERNAME:-moviepilot}"
    local entry n=0
    while IFS= read -r entry; do
        [ -n "${entry}" ] && [ -d "${entry}" ] || continue
        setfacl -x "u:${app_user}" "${entry}" 2>/dev/null || true
        n=$((n + 1))
    done < "${granted_file}"
    rm -f "${granted_file}"
    log "已清理 ${n} 条历史 ACL 条目"
}
revoke_browse_grants

log "=== MoviePilot 已卸载（用户数据保留在共享区）==="
exit 0
