#!/bin/bash
#
# install_callback — 释放 fpk 内置 payload 并完成离线安装
#
# 执行时机：fnOS 应用中心将 fpk 解压到 target 后调用本脚本（以 root 身份）。
#
# v3 架构（零网络安装）：
#   fpk 内置 payload.tar（src/app/payload.tar，线上构建期组装，含源码/前端/
#   wheels/浏览器内核/资源），fnpack 解压后位于 ${TRIM_APPDEST}/payload.tar。
#   本脚本只做释放 + 设备端 venv 离线装配 + 初始化，全程不访问外网。
#
# payload.tar 内容（释放到 TRIM_PKGVAR）：
#   MoviePilot/               上游源码快照（含 public/ 前端成品、app/application/site/ 资源）
#   wheels/                   pip wheels（--no-index 离线安装）
#   payload.lock              精确依赖清单（name==version）
#   payload.meta              元信息（KERNEL_VERSION / LOCK_SHA256 / UPSTREAM_TAG / ARCH）
#   kernel/chromium-<v>.tar   CloakBrowser 内核（重组为 chromium-<v>/ 前缀的裸 tar）
#
# 幂等：重复执行不会破坏共享区用户数据（config/数据库在共享区，不在释放范围）。

set -uo pipefail

# ===== fnOS 运行上下文 =====
APP_DEST="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"              # 程序本体（源码/venv/内核），私有区 @appdata
APP_USER="${TRIM_USERNAME:-moviepilot}"
APP_GROUP="${TRIM_GROUPNAME:-moviepilot}"
ERR_FILE="${TRIM_TEMP_LOGFILE}"

INSTALL_LOG="${DATA_DIR}/install.log"
MP_ROOT="${DATA_DIR}/MoviePilot"       # MoviePilot 运行根目录（上游 ROOT）
PAYLOAD_TAR="${APP_DEST}/payload.tar"
WHEELS_DIR="${DATA_DIR}/wheels"
PAYLOAD_LOCK="${DATA_DIR}/payload.lock"
PAYLOAD_META="${DATA_DIR}/payload.meta"
CLOAK_CACHE="${DATA_DIR}/cloakbrowser-cache"

# Node 运行时：fnOS 应用中心依赖 nodejs_v24（manifest install_dep_apps 声明，
# 安装时自动拉取），路径固定。上游 _frontend_node_binary 优先找 .runtime/node/bin/node，
# 我们用符号链接指过去。
NODE_DEP_BIN="/var/apps/nodejs_v24/target/bin"

# ===== 管理员账号（安装向导输入，留空用默认值兜底）=====
SUPERUSER="${wizard_superuser:-admin}"
SUPERUSER_PASSWORD="${wizard_password:-moviepilot123}"

# ===== payload.meta 解析结果 =====
KERNEL_VERSION=""                      # CloakBrowser 内核版本（chromium-<v>）
LOCK_SHA256=""                         # payload.lock 哈希（升级时判断 venv 是否复用）
UPSTREAM_TAG=""                        # 上游版本 tag

# --------------------------------------------------------------------------
# 辅助函数
# --------------------------------------------------------------------------
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $*" | tee -a "${INSTALL_LOG}" 2>/dev/null || \
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $*"
}

fail() {
    log "[ERROR] $*"
    if [ -n "${ERR_FILE:-}" ]; then
        echo "MoviePilot 安装失败：$*" > "${ERR_FILE}" 2>/dev/null
    fi
    exit 1
}

# 解析共享区中 config 目录的真实物理路径（与 cmd/main 保持一致）。
resolve_config_dir() {
    local paths="${TRIM_DATA_SHARE_PATHS:-}"
    local p
    if [ -n "${paths}" ]; then
        local IFS=':'
        for p in ${paths}; do
            if [ -n "${p}" ] && echo "${p}" | grep -Eq '/config/?$'; then
                echo "${p}"
                return 0
            fi
        done
    fi
    if [ -d "/var/apps/moviepilot/share/config" ]; then
        echo "/var/apps/moviepilot/share/config"
        return 0
    fi
    return 1
}

# 读取 payload.meta 的 KEY=VALUE
read_meta() {
    local key="$1"
    [ -f "${PAYLOAD_META}" ] || return 1
    sed -n "s|^${key}=||p" "${PAYLOAD_META}" | head -1
}

# --------------------------------------------------------------------------
# 前置检查（venv 自检仅记录结论：真实验证与三级兜底在 create_venv，
# appcenter 安装上下文与交互 shell 环境差异大，预检结果不能代表创建必败）
# --------------------------------------------------------------------------
preflight() {
    log "=== 前置检查 ==="
    [ -n "${APP_DEST:-}" ] || fail "TRIM_APPDEST 未设置"
    [ -n "${DATA_DIR:-}" ] || fail "TRIM_PKGVAR 未设置"
    [ -f "${PAYLOAD_TAR}" ] || fail "payload.tar 缺失：${PAYLOAD_TAR}（fpk 损坏或为占位包）"

    command -v python3 >/dev/null 2>&1 || fail "未找到 python3（需飞牛内置 Python 3.11+）"
    PY_VER="$(python3 -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null || echo 0)"
    PY_MAJOR="$(echo "${PY_VER}" | cut -d. -f1)"
    PY_MINOR="$(echo "${PY_VER}" | cut -d. -f2)"
    if [ "${PY_MAJOR}" -lt 3 ] || { [ "${PY_MAJOR}" -eq 3 ] && [ "${PY_MINOR}" -lt 11 ]; }; then
        fail "需要 Python 3.11+，当前为 ${PY_VER}（内置 Python 版本由飞牛系统控制）"
    fi
    log "Python: ${PY_VER} ($(command -v python3))"

    if [ -x "${NODE_DEP_BIN}/node" ]; then
        log "Node: $("${NODE_DEP_BIN}/node" --version 2>/dev/null)（nodejs_v24 依赖）"
    else
        fail "未找到 nodejs_v24 运行时：${NODE_DEP_BIN}/node（manifest install_dep_apps 未生效？）"
    fi

    # venv 能力自检（真建一次测试 venv；失败不阻断，create_venv 有三级兜底）
    local test_dir
    test_dir="$(mktemp -d)"
    if python3 -m venv "${test_dir}/t" >> "${INSTALL_LOG}" 2>&1 \
       && [ -x "${test_dir}/t/bin/pip" ] \
       && "${test_dir}/t/bin/pip" --version >/dev/null 2>&1; then
        log "venv 自检通过（ensurepip 可用）"
    else
        log "[WARN] venv 自检未通过（ensurepip 缺失或环境受限），创建时将走 --without-pip / 手工构建兜底"
    fi
    rm -rf "${test_dir}"

    log "前置检查通过"
}

# --------------------------------------------------------------------------
# 释放 payload（一遍流式落盘）
# var 下旧内容全量丢弃重铺：payload 即唯一事实源（存量 v2 的 git 检出/旧 venv
# 会被自然替换；共享区 config 不在释放范围，用户数据安全）。
# --------------------------------------------------------------------------
release_payload() {
    log "=== 释放 payload（$(du -h "${PAYLOAD_TAR}" 2>/dev/null | cut -f1)）==="
    mkdir -p "${DATA_DIR}"
    rm -rf "${MP_ROOT}" "${WHEELS_DIR}" "${DATA_DIR}/kernel"
    rm -f "${PAYLOAD_LOCK}" "${PAYLOAD_META}"
    if ! tar -xf "${PAYLOAD_TAR}" -C "${DATA_DIR}" >> "${INSTALL_LOG}" 2>&1; then
        fail "payload 释放失败（payload.tar 损坏？）"
    fi
    [ -x "${MP_ROOT}/moviepilot" ] || fail "释放后未找到 ${MP_ROOT}/moviepilot（payload 结构异常）"
    [ -f "${PAYLOAD_LOCK}" ] || fail "释放后未找到 payload.lock"
    [ -f "${PAYLOAD_META}" ] || fail "释放后未找到 payload.meta"

    KERNEL_VERSION="$(read_meta KERNEL_VERSION)"
    LOCK_SHA256="$(read_meta LOCK_SHA256)"
    UPSTREAM_TAG="$(read_meta UPSTREAM_TAG)"
    [ -n "${KERNEL_VERSION}" ] || fail "payload.meta 缺少 KERNEL_VERSION"
    [ -n "${LOCK_SHA256}" ] || fail "payload.meta 缺少 LOCK_SHA256"
    log "payload 就绪：上游 ${UPSTREAM_TAG:-未知}，内核 chromium-${KERNEL_VERSION}，lock ${LOCK_SHA256:0:12}..."

    # 悬空符号链接清扫：appcenter 在回调返回后会 chown 遍历 var，
    # 一个 dangling symlink 就会 ENOENT 中止整个安装（dsh 项目实战踩坑）。
    find "${DATA_DIR}" -xtype l -delete 2>/dev/null || true
}

# --------------------------------------------------------------------------
# Node 符号链接：MP_ROOT/.runtime/node/bin/node → nodejs_v24
# 上游 _frontend_node_binary 优先找 .runtime/node/bin/node，找不到再 which("node")。
# --------------------------------------------------------------------------
setup_node_symlinks() {
    log "=== 配置 Node 运行时（nodejs_v24）==="
    local link_dir="${MP_ROOT}/.runtime/node/bin"
    mkdir -p "${link_dir}"
    ln -sfn "${NODE_DEP_BIN}/node" "${link_dir}/node"
    local reported
    reported="$("${link_dir}/node" --version 2>/dev/null)"
    [ -n "${reported}" ] || fail "Node 符号链接不可用：${link_dir}/node"
    log "Node 符号链接就绪 → ${NODE_DEP_BIN}（${reported}）"
}

# --------------------------------------------------------------------------
# 设备端 venv：离线 pip 安装（方案 A）
# 三级兜底（appcenter 安装上下文实测存在 python -m venv 静默失败的环境）：
#   ① python3 -m venv（标准）② --without-pip ③ 手工构建（目录 + pyvenv.cfg
#   + 符号链接，完全不依赖 venv 模块）——pip 一律由随包 wheel 自举补齐。
# --------------------------------------------------------------------------
# 手工构建 venv：等价于 venv 模块的核心产物（pyvenv.cfg + bin/python 链接 +
# site-packages），venv 模块不可用/受限时的最终兜底。
manual_venv() {
    local venv_dir="$1"
    local py_bin py_home py_full pyver
    py_bin="$(command -v python3)"
    py_home="$(dirname "${py_bin}")"
    py_full="$("${py_bin}" -c 'import platform; print(platform.python_version())' 2>/dev/null)" || return 1
    pyver="$("${py_bin}" -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")' 2>/dev/null)" || return 1
    rm -rf "${venv_dir}"
    mkdir -p "${venv_dir}/bin" "${venv_dir}/lib/python${pyver}/site-packages" "${venv_dir}/include" \
        || return 1
    printf 'home = %s\ninclude-system-site-packages = false\nversion = %s\n' \
        "${py_home}" "${py_full}" > "${venv_dir}/pyvenv.cfg" || return 1
    ln -sfn "${py_bin}" "${venv_dir}/bin/python3"
    ln -sfn python3 "${venv_dir}/bin/python"
    # 自证可用：venv 结构下 python 必须能定位自身 prefix 并跑起来
    "${venv_dir}/bin/python" -c 'import sys; print("manual venv OK:", sys.prefix)' \
        >> "${INSTALL_LOG}" 2>&1 || return 1
}

create_venv() {
    log "=== 创建虚拟环境（离线装配）==="
    local venv_dir="${MP_ROOT}/venv"

    rm -rf "${venv_dir}"
    if python3 -m venv "${venv_dir}" >> "${INSTALL_LOG}" 2>&1; then
        log "venv 创建成功（标准模式）"
    elif python3 -m venv --without-pip "${venv_dir}" >> "${INSTALL_LOG}" 2>&1; then
        log "venv 创建成功（--without-pip 模式，pip 稍后自举）"
    else
        # 记录上下文快照供事后排查（appcenter 环境与交互 shell 差异大）
        log "[WARN] python3 -m venv 两种模式均失败，转手工构建 venv"
        log "[WARN] 诊断：user=$(id -un 2>/dev/null) HOME=${HOME:-未设置} TMPDIR=${TMPDIR:-未设置} PATH=${PATH}"
        manual_venv "${venv_dir}" || fail "手工 venv 构建失败（详见 ${INSTALL_LOG}）"
        log "venv 手工构建成功"
    fi

    # pip 缺失（--without-pip / 手工模式 / ensurepip 半损）→ 随包 pip wheel 自举
    if [ ! -x "${venv_dir}/bin/pip" ]; then
        local pip_wheel
        pip_wheel="$(ls "${WHEELS_DIR}"/pip-*.whl 2>/dev/null | head -1)"
        [ -n "${pip_wheel}" ] || fail "venv 缺少 pip 且随包 wheels 无 pip wheel，无法自举"
        "${venv_dir}/bin/python" "${pip_wheel}/pip" install --no-index --find-links "${WHEELS_DIR}" pip \
            >> "${INSTALL_LOG}" 2>&1 || fail "pip wheel 自举失败"
        log "pip 自举完成（$(basename "${pip_wheel}")）"
    fi

    log "离线安装依赖（wheels: $(ls "${WHEELS_DIR}" | wc -l) 个文件）..."
    if ! "${venv_dir}/bin/pip" install --no-index --find-links "${WHEELS_DIR}" \
            -r "${PAYLOAD_LOCK}" >> "${INSTALL_LOG}" 2>&1; then
        fail "依赖离线安装失败（详见 ${INSTALL_LOG}）"
    fi
    [ -x "${venv_dir}/bin/python" ] || fail "venv python 不可用：${venv_dir}/bin/python"
    log "venv 就绪：$("${venv_dir}/bin/python" --version 2>&1)"
}

# --------------------------------------------------------------------------
# 释放 CloakBrowser 内核到 CLOAKBROWSER_CACHE_DIR
# cloakbrowser ensure_binary 期望 <cache>/chromium-<v>/chrome，命中即跳过联网。
# --------------------------------------------------------------------------
release_kernel() {
    log "=== 释放 CloakBrowser 内核（chromium-${KERNEL_VERSION}）==="
    local bin_dir="${CLOAK_CACHE}/chromium-${KERNEL_VERSION}"
    if [ -x "${bin_dir}/chrome" ]; then
        log "内核已就绪，跳过：${bin_dir}"
        return 0
    fi
    [ -f "${DATA_DIR}/kernel/chromium-${KERNEL_VERSION}.tar" ] \
        || fail "内核包缺失：kernel/chromium-${KERNEL_VERSION}.tar"
    mkdir -p "${CLOAK_CACHE}"
    if ! tar -xf "${DATA_DIR}/kernel/chromium-${KERNEL_VERSION}.tar" -C "${CLOAK_CACHE}" >> "${INSTALL_LOG}" 2>&1; then
        fail "内核释放失败"
    fi
    chmod +x "${bin_dir}/chrome" 2>/dev/null || true
    [ -x "${bin_dir}/chrome" ] || fail "内核释放后未找到可执行 chrome：${bin_dir}/chrome"
    log "内核就绪：${bin_dir}/chrome"
}

# --------------------------------------------------------------------------
# 写 .moviepilot.env（固定 CONFIG_DIR）+ app.env 预置自动更新关闭
# moviepilot CLI 启动时 source .moviepilot.env 定位配置目录。
# MOVIEPILOT_AUTO_UPDATE=false：v3 默认 "release"（启动即联网更新），必须关死，
# 唯一更新通道 = 安装新 fpk（源码快照非 git，联网更新本就走不通）。
# --------------------------------------------------------------------------
write_env_config() {
    log "=== 写入配置定位与运行开关 ==="
    CONFIG_DIR="$(resolve_config_dir)" || fail "无法定位共享区 config 目录（检查 TRIM_DATA_SHARE_PATHS）"
    mkdir -p "${CONFIG_DIR}"
    log "CONFIG_DIR=${CONFIG_DIR}"
    cat > "${MP_ROOT}/.moviepilot.env" <<EOF
# 由 fn-native-moviepilot install_callback 生成
# 固定 MoviePilot 配置目录到共享区，用户可在文件管理器中查看管理
CONFIG_DIR=${CONFIG_DIR}
EOF

    local env_file="${CONFIG_DIR}/app.env"
    touch "${env_file}"
    if grep -qE "^[[:space:]]*MOVIEPILOT_AUTO_UPDATE=" "${env_file}"; then
        sed -i -E "s|^[[:space:]]*MOVIEPILOT_AUTO_UPDATE=.*|MOVIEPILOT_AUTO_UPDATE=false|" "${env_file}"
    else
        [ -s "${env_file}" ] && [ "$(tail -c1 "${env_file}" 2>/dev/null)" != $'\n' ] && printf '\n' >> "${env_file}"
        printf 'MOVIEPILOT_AUTO_UPDATE=false\n' >> "${env_file}"
    fi
    log "MOVIEPILOT_AUTO_UPDATE=false 已写入 app.env"

    ensure_secret_keys
    ensure_direct_env_defaults
}

# --------------------------------------------------------------------------
# 无梯子直连默认值（仅缺失时写入，用户已改过的值绝不覆盖）
# 真机实测（2026-08，详见 docs/v3-build-plan.md §13）：
# - api.themoviedb.org 的 DNS 被污染（解析到无关网段，TCP 不通）→ 探索/识别全断；
#   官方别名 api.tmdb.org 未被污染、同源服务，直连 0.7s 可用。
# - raw.githubusercontent.com 直连间歇性重置（4 测 2 断）→ 插件市场时好时坏；
#   ghproxy.net 为实测最快的可用加速镜像（镜像有生命周期，失效后可在
#   设定→高级设置→网络 中清除或更换，MP 会自动回退直连策略）。
# - api.bgm.tv 被 DNS 污染 + SNI 重置双重封锁，无镜像则 Bangumi 数据源全断；
#   api.bangumi.lol（Mirrox 开源反代）实测直连可用且自动改写图片域（需配合
#   构建期「Bangumi API 域名可配置」补丁）。第三方镜像可见查询内容，介意者
#   可在 app.env 中改回 api.bgm.tv（需梯子）。
# --------------------------------------------------------------------------
ensure_direct_env_defaults() {
    local env_file="${CONFIG_DIR}/app.env"
    touch "${env_file}"
    local kv key val
    for kv in "TMDB_API_DOMAIN=api.tmdb.org" "GITHUB_PROXY=https://ghproxy.net/" "BANGUMI_API_DOMAIN=api.bangumi.lol"; do
        key="${kv%%=*}" val="${kv#*=}"
        if grep -qE "^[[:space:]]*${key}=" "${env_file}"; then
            log "${key} 已有配置，保持不变"
            continue
        fi
        [ -s "${env_file}" ] && [ "$(tail -c1 "${env_file}" 2>/dev/null)" != $'\n' ] && printf '\n' >> "${env_file}"
        printf "%s='%s'\n" "${key}" "${val}" >> "${env_file}"
        log "${key} 默认值已写入 app.env（无梯子直连优化）"
    done
}

# --------------------------------------------------------------------------
# 持久化 JWT/资源签名密钥（缺失才生成，绝不覆盖已有值）
# 上游默认每次进程启动随机生成 SECRET_KEY / RESOURCE_SECRET_KEY → 重启后
# 所有登录态与图片 URL 签名全部失效，用户被迫重新登录。写入 app.env 固定后，
# 重启/升级均保持登录态（Docker 用户同理通过环境变量固定）。
# --------------------------------------------------------------------------
ensure_secret_keys() {
    local env_file="${CONFIG_DIR}/app.env"
    touch "${env_file}"
    local key val
    for key in SECRET_KEY RESOURCE_SECRET_KEY; do
        if grep -qE "^[[:space:]]*${key}=" "${env_file}"; then
            log "${key} 已存在，保持不变"
            continue
        fi
        val="$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')"
        [ -n "${val}" ] || fail "生成 ${key} 失败"
        [ -s "${env_file}" ] && [ "$(tail -c1 "${env_file}" 2>/dev/null)" != $'\n' ] && printf '\n' >> "${env_file}"
        printf '%s=%s\n' "${key}" "${val}" >> "${env_file}"
        log "${key} 已生成并写入 app.env"
    done
}

# --------------------------------------------------------------------------
# 运行上游 init（资源已随 payload 就位，传 --skip-resources）
# 非交互：API_TOKEN 缺失时自动生成；superuser/password 由参数预置写入 app.env
# 并同步数据库账号。
# --------------------------------------------------------------------------
run_init() {
    log "=== 初始化 MoviePilot（${UPSTREAM_TAG}）==="
    cd "${MP_ROOT}" || fail "无法进入 ${MP_ROOT}"
    export PATH="${MP_ROOT}/.runtime/node/bin:${NODE_DEP_BIN}:${PATH}"
    export HOME="${TRIM_PKGHOME:-${DATA_DIR}}"
    export CLOAKBROWSER_CACHE_DIR="${CLOAK_CACHE}"

    if ! ./moviepilot init \
            --skip-resources \
            --superuser "${SUPERUSER}" \
            --superuser-password "${SUPERUSER_PASSWORD}" \
            --config-dir "${CONFIG_DIR}" >> "${INSTALL_LOG}" 2>&1; then
        fail "moviepilot init 失败（详见 ${INSTALL_LOG}）"
    fi
    log "init 完成"
}

# --------------------------------------------------------------------------
# 收尾：删临时载荷（wheels/kernel/payload.tar），保留 payload.lock + payload.meta
# （升级时用 LOCK_SHA256 判断 venv 复用）；修正属主。
# --------------------------------------------------------------------------
cleanup_and_chown() {
    log "=== 收尾 ==="
    rm -rf "${WHEELS_DIR}" "${DATA_DIR}/kernel" "${MP_ROOT}/wheels"
    rm -f "${PAYLOAD_TAR}"
    log "已清理 wheels / kernel / payload.tar"

    find "${DATA_DIR}" -xtype l -delete 2>/dev/null || true
    chown -R "${APP_USER}:${APP_GROUP}" "${DATA_DIR}" 2>/dev/null || \
        log "[WARN] chown ${DATA_DIR} 失败（可能权限受限）"
    chown -R "${APP_USER}:${APP_GROUP}" "${CONFIG_DIR}" 2>/dev/null || \
        log "[WARN] chown ${CONFIG_DIR} 失败"
    log "属主修正完成：${APP_USER}:${APP_GROUP}"
}

# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------
mkdir -p "${DATA_DIR}"
preflight
release_payload
setup_node_symlinks
create_venv
release_kernel
write_env_config
run_init
cleanup_and_chown

log "=== MoviePilot 安装完成（离线，${UPSTREAM_TAG}）==="
log "访问：fnOS 桌面点击 MoviePilot 图标（统一网关 /app/moviepilot）  账号：${SUPERUSER}（首次登录请改密）"
log "配置目录：${CONFIG_DIR}"
exit 0
