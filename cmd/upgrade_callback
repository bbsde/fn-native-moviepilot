#!/bin/bash
#
# upgrade_callback — 应用升级后执行
#
# git 部署模式下：fnOS 用新 fpk 覆盖 target（仅含脚本/内核，不含源码），保留 var。
# 本脚本：停服务 → git pull 更新后端源码 → 重建依赖/内核 → chown。
# 用户也可通过 MoviePilot 网页或 `moviepilot update` 自行更新（同样走 git 镜像）。
# 共享区 config 全程不动，账号数据保留。

set -uo pipefail

APP_DEST="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"
APP_USER="${TRIM_USERNAME:-moviepilot}"
APP_GROUP="${TRIM_GROUPNAME:-moviepilot}"
ERR_FILE="${TRIM_TEMP_LOGFILE}"
NODE_RUNTIME_BIN="/var/apps/nodejs_v24/target/bin"

INSTALL_LOG="${DATA_DIR}/install.log"
MP_ROOT="${DATA_DIR}/MoviePilot"

# 国内镜像源（与 install_callback 一致）
PIP_MIRROR="https://pypi.tuna.tsinghua.edu.cn/simple"
NPM_REGISTRY="https://registry.npmmirror.com"
# GitHub 加速镜像（运行时探测，见 probe_github_mirror）
GITHUB_PREFIX=""
GITHUB_MIRROR=""
PROBE="${APP_DEST}/bin/github-mirror-probe"
WRAPPER="${APP_DEST}/bin/curl-github-mirror"

# CloakBrowser 浏览器内核（与 install_callback 一致）
CLOAKBROWSER_VERSION="146.0.7680.177.5"
CLOAKBROWSER_RELEASE="https://github.com/bbsde/fn-native-moviepilot/releases/download/v1.0.0/cloakbrowser-linux-x64.tar.gz"
CLOAKBROWSER_FALLBACK="https://cloakbrowser.dev/chromium-v${CLOAKBROWSER_VERSION}/cloakbrowser-linux-x64.tar.gz"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') | [UPGRADE] $*" | tee -a "${INSTALL_LOG}" 2>/dev/null || \
    echo "$(date '+%Y-%m-%d %H:%M:%S') | [UPGRADE] $*"
}
fail() {
    log "[ERROR] $*"
    [ -n "${ERR_FILE:-}" ] && echo "MoviePilot 升级失败：$*" > "${ERR_FILE}" 2>/dev/null
    exit 1
}

resolve_config_dir() {
    local paths="${TRIM_DATA_SHARE_PATHS:-}" p
    if [ -n "${paths}" ]; then
        local IFS=':'
        for p in ${paths}; do
            if [ -n "${p}" ] && echo "${p}" | grep -Eq '/config/?$'; then echo "${p}"; return 0; fi
        done
    fi
    [ -d "/var/apps/moviepilot/share/config" ] && { echo "/var/apps/moviepilot/share/config"; return 0; }
    return 1
}

# 停止运行中的服务（尽量优雅；若 CLI 不可用则跳过）
stop_service() {
    log "停止旧版本服务 ..."
    if [ -x "${MP_ROOT}/moviepilot" ]; then
        export PATH="${NODE_RUNTIME_BIN}:${PATH}"
        ( cd "${MP_ROOT}" && ./moviepilot stop --timeout 30 ) >> "${INSTALL_LOG}" 2>&1 || \
            log "[WARN] stop 返回非零（可能本就未运行）"
    fi
}

# 探测 GitHub 加速镜像（与 install_callback 一致）
probe_github_mirror() {
    log "探测 GitHub 加速镜像"
    [ -x "${PROBE}" ] || chmod +x "${PROBE}" 2>/dev/null || true
    if [ -x "${PROBE}" ]; then
        GITHUB_PREFIX="$("${PROBE}" git 2>/dev/null | tail -1)"
    fi
    if [ -n "${GITHUB_PREFIX}" ]; then
        GITHUB_MIRROR="${GITHUB_PREFIX}"
    elif [ -x "${PROBE}" ]; then
        GITHUB_MIRROR="$("${PROBE}" curl 2>/dev/null | tail -1)"
    fi
    [ -n "${GITHUB_PREFIX}" ] && log "git 镜像：${GITHUB_PREFIX}" || log "[WARN] 无可用 git 镜像，直连"
}

# git pull 更新后端源码（走镜像）
update_source() {
    log "更新后端源码（git pull）"
    [ -d "${MP_ROOT}/.git" ] || fail "${MP_ROOT} 不是 git 仓库，无法升级"
    # 配置 git 镜像（探测到的前缀）
    if [ -n "${GITHUB_PREFIX}" ]; then
        git config --global "url.${GITHUB_PREFIX}/.insteadOf" "https://github.com/" 2>/dev/null || true
    fi
    cd "${MP_ROOT}" || fail "无法进入 ${MP_ROOT}"
    if ! git pull --ff-only >> "${INSTALL_LOG}" 2>&1; then
        fail "git pull 失败（检查网络/镜像 ${GITHUB_PREFIX:-直连}）"
    fi
    log "源码更新完成：$(git log -1 --format='%h %s' 2>/dev/null)"
}

setup_node_symlinks() {
    log "重建 Node 符号链接"
    [ -x "${NODE_RUNTIME_BIN}/node" ] || fail "Node 运行时缺失：${NODE_RUNTIME_BIN}/node"
    local link_dir="${MP_ROOT}/.runtime/node/bin"
    mkdir -p "${link_dir}"
    ln -sfn "${NODE_RUNTIME_BIN}/node" "${link_dir}/node"
    ln -sfn "${NODE_RUNTIME_BIN}/npm"  "${link_dir}/npm"
    NODE_VER="$("${NODE_RUNTIME_BIN}/node" --version | sed 's/^v//')"
}

setup_github_mirror() {
    [ -e "${WRAPPER}" ] || { log "[WARN] curl 包装器不存在：${WRAPPER}，跳过 GitHub 镜像"; return 0; }
    [ -n "${GITHUB_PREFIX}" ] || { log "[WARN] 无可用 GitHub 镜像，curl 不走镜像"; return 0; }
    chmod +x "${WRAPPER}" 2>/dev/null
    local mirror_bin="${MP_ROOT}/.gh-mirror-bin"
    mkdir -p "${mirror_bin}"
    ln -sfn "${WRAPPER}" "${mirror_bin}/curl"
    export PATH="${mirror_bin}:${PATH}"
    export GITHUB_PREFIX="${GITHUB_PREFIX}"
    log "GitHub curl 镜像已启用：${GITHUB_PREFIX}"
}

deploy_cloakbrowser_binary() {
    log "下载并释放 CloakBrowser 浏览器内核"
    local cache_dir="${CLOAKBROWSER_CACHE_DIR}"
    local bin_dir="${cache_dir}/chromium-${CLOAKBROWSER_VERSION}"
    local chrome_bin="${bin_dir}/chrome"
    mkdir -p "${cache_dir}"
    if [ -x "${chrome_bin}" ]; then log "内核已就绪，跳过"; return 0; fi
    local tmp_tar="${cache_dir}/.cloakbrowser.tar.gz"
    log "下载内核（~200MB，走 GitHub 镜像加速）..."
    if ! curl -fSL --retry 3 --connect-timeout 15 -o "${tmp_tar}" "${CLOAKBROWSER_RELEASE}" 2>> "${INSTALL_LOG}"; then
        log "[WARN] GitHub Release 下载失败，回退官方源"
        if ! curl -fSL --retry 3 --connect-timeout 15 -o "${tmp_tar}" "${CLOAKBROWSER_FALLBACK}" 2>> "${INSTALL_LOG}"; then
            rm -f "${tmp_tar}"; fail "CloakBrowser 内核下载失败"
        fi
    fi
    rm -rf "${bin_dir}"; mkdir -p "${bin_dir}"
    if ! tar -xzf "${tmp_tar}" -C "${bin_dir}" 2>> "${INSTALL_LOG}"; then rm -rf "${bin_dir}" "${tmp_tar}"; fail "解压内核失败"; fi
    rm -f "${tmp_tar}"
    chmod +x "${chrome_bin}" 2>/dev/null || true
    [ -x "${chrome_bin}" ] || fail "内核释放失败：${chrome_bin}"
    log "内核就绪：${chrome_bin}"
}

run_setup() {
    log "重建运行环境（setup --recreate）"
    CONFIG_DIR="$(resolve_config_dir)" || fail "无法定位 config 目录"
    cat > "${MP_ROOT}/.moviepilot.env" <<EOF
CONFIG_DIR=${CONFIG_DIR}
EOF
    cd "${MP_ROOT}" || fail "无法进入 ${MP_ROOT}"
    # 注入国内镜像源（不设 PIP_PROXY，避免与 pip 的 HTTP 代理语义冲突）
    export PIP_INDEX_URL="${PIP_MIRROR}"
    export UV_DEFAULT_INDEX="${PIP_MIRROR}"
    export npm_config_registry="${NPM_REGISTRY}"
    setup_github_mirror
    # HOME / CloakBrowser 内核目录（与 install_callback 保持一致）
    export HOME="${TRIM_PKGHOME:-${DATA_DIR}}"
    export CLOAKBROWSER_CACHE_DIR="${DATA_DIR}/cloakbrowser-cache"
    mkdir -p "${CLOAKBROWSER_CACHE_DIR}"
    deploy_cloakbrowser_binary
    # 升级时不传 --superuser/--superuser-password，保留用户已有的账号数据
    local setup_cmd="./moviepilot setup \
        --python /usr/bin/python3 --node-version ${NODE_VER} --recreate \
        --config-dir ${CONFIG_DIR}"
    log "执行：${setup_cmd}（镜像源：PIP=${PIP_MIRROR} NPM=${NPM_REGISTRY}）"
    if ! bash -c "${setup_cmd}" >> "${INSTALL_LOG}" 2>&1; then
        fail "setup 失败，详见 ${INSTALL_LOG}"
    fi
}

fix_ownership() {
    log "修正属主"
    chown -R "${APP_USER}:${APP_GROUP}" "${DATA_DIR}" 2>/dev/null || log "[WARN] chown ${DATA_DIR} 失败"
    chown -R "${APP_USER}:${APP_GROUP}" "${CONFIG_DIR}" 2>/dev/null || true
}

stop_service
probe_github_mirror
update_source
setup_node_symlinks
run_setup
fix_ownership

log "=== MoviePilot 升级完成 ==="
exit 0
