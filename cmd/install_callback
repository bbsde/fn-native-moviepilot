#!/bin/bash
#
# install_callback — 安装 MoviePilot 后端 + 前端运行环境
#
# 执行时机：fnOS 应用中心将 fpk 解压到 target 后调用本脚本（以 root 身份）。
# 作用：把源码包部署到持久数据区，借助上游 local_setup.py 完成依赖安装、
#       前端下载、资源配置和数据库初始化。全程无人值守。
#
# 幂等：重复执行不会破坏已有数据（venv、config 复用）。

set -uo pipefail

# ===== fnOS 运行上下文 =====
APP_DEST="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"              # 程序本体（源码/venv/前端），私有区 @appdata
APP_USER="${TRIM_USERNAME:-moviepilot}"
APP_GROUP="${TRIM_GROUPNAME:-moviepilot}"
ERR_FILE="${TRIM_TEMP_LOGFILE}"
NODE_RUNTIME_BIN="/var/apps/nodejs_v24/target/bin"

INSTALL_LOG="${DATA_DIR}/install.log"
MP_ROOT="${DATA_DIR}/MoviePilot"       # MoviePilot 运行根目录（ROOT）

# ===== 源码仓库（git 部署，支持网页内更新）=====
# clone v2 分支（跟踪最新），用户可通过 MoviePilot 网页或 moviepilot update 在线更新。
# 通过 GITHUB_MIRROR 加速 clone 与后续 pull。
MP_REPO="https://github.com/jxxghp/MoviePilot.git"
MP_BRANCH="v2"

# ===== 管理员账号（优先取安装向导输入，留空则用默认值兜底）=====
# 向导字段 wizard_superuser / wizard_password 由 wizard/install 收集，作为环境变量传入。
# 兜底默认值须满足 MoviePilot 密码强度（字母、数字、特殊字符中至少两类）。
SUPERUSER="${wizard_superuser:-admin}"
SUPERUSER_PASSWORD="${wizard_password:-moviepilot123}"

# ===== 国内镜像源（加速国内 NAS 安装）=====
# 注意：不要设 PIP_PROXY！该名字会被 pip 原生当作 HTTP 代理（语义冲突）。
# 只用 PIP_INDEX_URL / UV_DEFAULT_INDEX 指定镜像 index。
PIP_MIRROR="https://pypi.tuna.tsinghua.edu.cn/simple"
# npm 通过 npm_config_registry 环境变量切换 registry
NPM_REGISTRY="https://registry.npmmirror.com"
# GitHub 加速镜像（运行时探测最优，见 probe_github_mirror）
# GITHUB_PREFIX 为拼接好 github.com 的完整前缀；GITHUB_MIRROR 供 curl wrapper 使用。
GITHUB_PREFIX=""
GITHUB_MIRROR=""
# 探测脚本（随 fpk 分发）
PROBE="${APP_DEST}/bin/github-mirror-probe"
# curl 包装器（随 fpk 分发）：拦截 github.com 下载走镜像
WRAPPER="${APP_DEST}/bin/curl-github-mirror"

# ===== CloakBrowser 浏览器内核（安装时从 GitHub Release 下载，走 gh-proxy 加速）=====
# 版本须与 cloakbrowser 包期望的 CHROMIUM_VERSION 一致（config.py: linux-x64 → 146.0.7680.177.5）
# cloakbrowser 的 ensure_binary 检测到 chrome 已存在且可执行即跳过下载。
# 下载通过 curl-github-mirror wrapper 自动走国内镜像加速；失败回退 cloakbrowser.dev 官方源。
#
# ⚠️ git 部署的版本错配风险：用户通过网页 `moviepilot update` 拉取新版后端后，
# 若新版 requirements.in 升级了 cloakbrowser 包版本（内核版本号随之变化），
# 此内核将不匹配，cloakbrowser install 会联网下载匹配的新内核。
CLOAKBROWSER_VERSION="146.0.7680.177.5"
CLOAKBROWSER_RELEASE="https://github.com/bbsde/fn-native-moviepilot/releases/download/v1.0.0/cloakbrowser-linux-x64.tar.gz"
CLOAKBROWSER_FALLBACK="https://cloakbrowser.dev/chromium-v${CLOAKBROWSER_VERSION}/cloakbrowser-linux-x64.tar.gz"

# --------------------------------------------------------------------------
# 辅助函数
# --------------------------------------------------------------------------
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $*" | tee -a "${INSTALL_LOG}" 2>/dev/null || \
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $*"
}

fail() {
    # 写入用户可见错误并退出。同时落到 install.log 便于排查。
    log "[ERROR] $*"
    if [ -n "${ERR_FILE:-}" ]; then
        echo "MoviePilot 安装失败：$*" > "${ERR_FILE}" 2>/dev/null
    fi
    exit 1
}

# 解析共享区中 config 目录的真实物理路径。
# TRIM_DATA_SHARE_PATHS 为冒号分隔的路径列表；声明的共享名 moviepilot/config
# 会对应一条以 /config 结尾的路径。优先用它；找不到则回退到 share 软链。
resolve_config_dir() {
    local paths="${TRIM_DATA_SHARE_PATHS:-}"
    local p
    # 1. 优先从 TRIM_DATA_SHARE_PATHS 找到以 /config 结尾者
    if [ -n "${paths}" ]; then
        local IFS=':'
        for p in ${paths}; do
            if [ -n "${p}" ] && echo "${p}" | grep -Eq '/config/?$'; then
                echo "${p}"
                return 0
            fi
        done
    fi
    # 2. 回退：share 软链
    if [ -d "/var/apps/moviepilot/share/config" ]; then
        echo "/var/apps/moviepilot/share/config"
        return 0
    fi
    return 1
}

# --------------------------------------------------------------------------
# 前置检查
# --------------------------------------------------------------------------
preflight() {
    log "=== 前置检查 ==="
    [ -n "${APP_DEST:-}" ] || fail "TRIM_APPDEST 未设置"
    [ -n "${DATA_DIR:-}" ] || fail "TRIM_PKGVAR 未设置"

    command -v git >/dev/null 2>&1 || fail "未找到 git（git 部署模式需要 git）"

    command -v python3 >/dev/null 2>&1 || fail "未找到 python3"
    PY_VER="$(python3 -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null || echo 0)"
    PY_MAJOR="$(echo "${PY_VER}" | cut -d. -f1)"
    PY_MINOR="$(echo "${PY_VER}" | cut -d. -f2)"
    if [ "${PY_MAJOR}" -lt 3 ] || { [ "${PY_MAJOR}" -eq 3 ] && [ "${PY_MINOR}" -lt 11 ]; }; then
        fail "需要 Python 3.11+，当前为 ${PY_VER}"
    fi
    log "Python: ${PY_VER} ($(command -v python3))"

    python3 -m venv --help >/dev/null 2>&1 || fail "python3 venv 模块不可用，无法创建虚拟环境"

    # Node 运行时（由 install_dep_apps=nodejs_v24 自动安装）
    if [ ! -x "${NODE_RUNTIME_BIN}/node" ]; then
        fail "未找到 Node 运行时：${NODE_RUNTIME_BIN}/node（依赖 nodejs_v24 是否安装成功？）"
    fi
    NODE_VER="$("${NODE_RUNTIME_BIN}/node" --version 2>/dev/null | sed 's/^v//')"
    [ -n "${NODE_VER}" ] || fail "无法获取 Node 版本"
    log "Node: v${NODE_VER} (${NODE_RUNTIME_BIN}/node)"

    log "前置检查通过"
}

# --------------------------------------------------------------------------
# 探测可用的 GitHub 加速镜像（git + curl 各探测一次）
# 得到 GITHUB_PREFIX（完整前缀）和 GITHUB_MIRROR（curl wrapper 用）。
# 全部不可用时回退直连（GITHUB_PREFIX 为空，git/curl 不走镜像）。
# --------------------------------------------------------------------------
probe_github_mirror() {
    log "=== 探测 GitHub 加速镜像 ==="
    [ -x "${PROBE}" ] || chmod +x "${PROBE}" 2>/dev/null || true

    # git 镜像（用于 clone/pull）
    if [ -x "${PROBE}" ]; then
        GITHUB_PREFIX="$("${PROBE}" git 2>/dev/null | tail -1)"
    fi
    # curl 镜像（用于 release/archive 下载）；优先复用 git 探测结果
    if [ -n "${GITHUB_PREFIX}" ]; then
        GITHUB_MIRROR="${GITHUB_PREFIX}"
    elif [ -x "${PROBE}" ]; then
        GITHUB_MIRROR="$("${PROBE}" curl 2>/dev/null | tail -1)"
    fi

    if [ -n "${GITHUB_PREFIX}" ]; then
        log "git 镜像：${GITHUB_PREFIX}"
    else
        log "[WARN] 无可用 git 镜像，clone/pull 将直连 GitHub"
    fi
    if [ -n "${GITHUB_MIRROR}" ]; then
        log "curl 镜像：${GITHUB_MIRROR}"
    else
        log "[WARN] 无可用 curl 镜像，前端/资源下载将直连 GitHub"
    fi
}
# 用 git 部署以支持网页内更新（moviepilot update 通过 git pull 升级后端）。
# 通过 GITHUB_MIRROR 加速；并配置 git url.insteadOf，使后续 pull 也走镜像。
# --------------------------------------------------------------------------
deploy_source() {
    log "=== 部署源码（git clone）==="
    mkdir -p "${DATA_DIR}"

    # 配置 git 镜像：把 github.com 的请求重写到探测到的镜像前缀
    # 作用于本次 clone 及后续所有 git 操作（含 moviepilot update 的 git pull）
    if [ -n "${GITHUB_PREFIX}" ]; then
        git config --global "url.${GITHUB_PREFIX}/.insteadOf" "https://github.com/" 2>/dev/null || true
    fi

    if [ -d "${MP_ROOT}/.git" ]; then
        log "源码已存在（git 仓库），跳过 clone：${MP_ROOT}"
    else
        log "clone ${MP_REPO} (分支 ${MP_BRANCH}) → ${MP_ROOT}"
        # 浅克隆加速；保留 .git 以支持后续 update
        if ! git clone --depth=1 --branch "${MP_BRANCH}" "${MP_REPO}" "${MP_ROOT}" >> "${INSTALL_LOG}" 2>&1; then
            rm -rf "${MP_ROOT}"
            fail "git clone 失败（检查网络/镜像 ${GITHUB_PREFIX:-直连}）"
        fi
        log "源码 clone 完成"
    fi
}

# --------------------------------------------------------------------------
# 创建 Node 符号链接（短路官方下载，省 40MB）
# install_node_runtime 检测到 .runtime/node/bin/node 存在且版本匹配时跳过下载。
# --------------------------------------------------------------------------
setup_node_symlinks() {
    log "=== 配置 Node 运行时（复用 nodejs_v24）==="
    local link_dir="${MP_ROOT}/.runtime/node/bin"
    mkdir -p "${link_dir}"
    ln -sfn "${NODE_RUNTIME_BIN}/node" "${link_dir}/node"
    ln -sfn "${NODE_RUNTIME_BIN}/npm"  "${link_dir}/npm"
    # 校验短路条件：版本号必须与 --node-version 完全一致
    local reported
    reported="$("${link_dir}/node" --version 2>/dev/null | sed 's/^v//')"
    if [ "${reported}" != "${NODE_VER}" ]; then
        fail "Node 符号链接版本校验失败：${reported} != ${NODE_VER}"
    fi
    log "Node 符号链接就绪 → ${link_dir} → ${NODE_RUNTIME_BIN}"
}

# --------------------------------------------------------------------------
# 写 .moviepilot.env（固定 CONFIG_DIR）
# moviepilot CLI 启动时会 source 这个文件以定位配置目录。
# --------------------------------------------------------------------------
write_env_file() {
    log "=== 写入配置定位文件 ==="
    CONFIG_DIR="$(resolve_config_dir)" || fail "无法定位共享区 config 目录（检查 TRIM_DATA_SHARE_PATHS）"
    mkdir -p "${CONFIG_DIR}"
    log "CONFIG_DIR=${CONFIG_DIR}"
    cat > "${MP_ROOT}/.moviepilot.env" <<EOF
# 由 fn-native-moviepilot install_callback 生成
# 固定 MoviePilot 配置目录到共享区，用户可在文件管理器中查看管理
CONFIG_DIR=${CONFIG_DIR}
EOF
    log ".moviepilot.env 已写入"
}

# --------------------------------------------------------------------------
# 配置 GitHub 下载走国内镜像（不改 MoviePilot 源码）
# 原理：local_setup.py 用 command_exists("curl") 选 curl 下载。建一个临时目录，
#       内放名为 curl 的软链 → 指向随包分发的 curl-github-mirror 包装器，
#       并把该目录置于 PATH 最前。包装器对 github.com URL 加镜像前缀，
#       其余原样透传；镜像失败自动降级直连。
# --------------------------------------------------------------------------
setup_github_mirror() {
    [ -e "${WRAPPER}" ] || { log "[WARN] curl 包装器不存在：${WRAPPER}，跳过 GitHub 镜像"; return 0; }
    [ -n "${GITHUB_PREFIX}" ] || { log "[WARN] 无可用 GitHub 镜像，curl 不走镜像"; return 0; }
    chmod +x "${WRAPPER}" 2>/dev/null  # 确保可执行（打包可能丢权限）
    local mirror_bin="${MP_ROOT}/.gh-mirror-bin"
    mkdir -p "${mirror_bin}"
    ln -sfn "${WRAPPER}" "${mirror_bin}/curl"
    export PATH="${mirror_bin}:${PATH}"
    export GITHUB_PREFIX="${GITHUB_PREFIX}"   # wrapper 读取此变量改写 URL
    log "GitHub curl 镜像已启用：${GITHUB_PREFIX}（wrapper: ${mirror_bin}/curl）"
}

# --------------------------------------------------------------------------
# 下载并释放 CloakBrowser 浏览器内核
# 从 GitHub Release 下载（curl wrapper 自动走国内镜像），失败回退官方源。
# cloakbrowser 的 ensure_binary 期望：$CLOAKBROWSER_CACHE_DIR/chromium-<ver>/chrome
# 在 setup 之前释放到位，setup 内的 `cloakbrowser install` 检测到已存在即跳过下载。
# --------------------------------------------------------------------------
deploy_cloakbrowser_binary() {
    log "=== 下载并释放 CloakBrowser 浏览器内核 ==="
    local cache_dir="${CLOAKBROWSER_CACHE_DIR}"
    local bin_dir="${cache_dir}/chromium-${CLOAKBROWSER_VERSION}"
    local chrome_bin="${bin_dir}/chrome"

    mkdir -p "${cache_dir}"

    # 已存在且可执行则跳过（幂等）
    if [ -x "${chrome_bin}" ]; then
        log "内核已就绪，跳过：${chrome_bin}"
        return 0
    fi

    # 下载内核包到临时文件（curl 已通过 setup_github_mirror 走镜像加速）
    local tmp_tar="${cache_dir}/.cloakbrowser.tar.gz"
    log "下载内核（~200MB，走 GitHub 镜像加速）..."
    # 先尝试 GitHub Release（经镜像），失败回退 cloakbrowser.dev 官方源
    if ! curl -fSL --retry 3 --connect-timeout 15 -o "${tmp_tar}" "${CLOAKBROWSER_RELEASE}" 2>> "${INSTALL_LOG}"; then
        log "[WARN] GitHub Release 下载失败，回退官方源：${CLOAKBROWSER_FALLBACK}"
        if ! curl -fSL --retry 3 --connect-timeout 15 -o "${tmp_tar}" "${CLOAKBROWSER_FALLBACK}" 2>> "${INSTALL_LOG}"; then
            rm -f "${tmp_tar}"
            fail "CloakBrowser 内核下载失败（GitHub Release 与官方源均不可用）"
        fi
    fi

    log "解压内核 → ${bin_dir}"
    rm -rf "${bin_dir}"
    mkdir -p "${bin_dir}"
    if ! tar -xzf "${tmp_tar}" -C "${bin_dir}" 2>> "${INSTALL_LOG}"; then
        rm -rf "${bin_dir}" "${tmp_tar}"
        fail "解压 CloakBrowser 内核失败"
    fi
    rm -f "${tmp_tar}"
    chmod +x "${chrome_bin}" 2>/dev/null || true
    [ -x "${chrome_bin}" ] || fail "内核释放后未找到可执行 chrome：${chrome_bin}"
    log "内核就绪：${chrome_bin}"
}

# --------------------------------------------------------------------------
# 运行上游无人值守 setup
# 依次完成：venv → pip 依赖 → CloakBrowser 内核 → 前端 dist + npm → 资源 → 初始化
# --------------------------------------------------------------------------
run_setup() {
    log "=== 运行 MoviePilot setup（无人值守，约 10~15 分钟）==="
    cd "${MP_ROOT}" || fail "无法进入 ${MP_ROOT}"

    # 注入国内镜像源环境变量（不设 PIP_PROXY，避免与 pip 的 HTTP 代理语义冲突）
    # PIP_INDEX_URL / UV_DEFAULT_INDEX → pip 与 uv 的镜像 index；npm_config_registry → npm install
    export PIP_INDEX_URL="${PIP_MIRROR}"
    export UV_DEFAULT_INDEX="${PIP_MIRROR}"
    export npm_config_registry="${NPM_REGISTRY}"
    setup_github_mirror
    log "镜像源：PIP=${PIP_MIRROR}  NPM=${NPM_REGISTRY}"

    # fnOS 应用用户无 /home/<user> 目录，CloakBrowser/Playwright 默认用 $HOME 下载内核会失败。
    # 把 HOME 指向 TRIM_PKGHOME（fnOS 真实应用 home 目录），并用 CLOAKBROWSER_CACHE_DIR
    # 把浏览器内核（~200MB）定向到持久数据区，运行时 cmd/main 保持一致才能复用。
    export HOME="${TRIM_PKGHOME:-${DATA_DIR}}"
    export CLOAKBROWSER_CACHE_DIR="${DATA_DIR}/cloakbrowser-cache"
    mkdir -p "${CLOAKBROWSER_CACHE_DIR}"
    log "HOME=${HOME}  CLOAKBROWSER_CACHE_DIR=${CLOAKBROWSER_CACHE_DIR}"

    # 释放内置浏览器内核（在 setup 之前，使 cloakbrowser install 跳过联网下载）
    deploy_cloakbrowser_binary

    local setup_cmd
    setup_cmd="./moviepilot setup \
        --python /usr/bin/python3 \
        --node-version ${NODE_VER} \
        --superuser ${SUPERUSER} \
        --superuser-password ${SUPERUSER_PASSWORD} \
        --config-dir ${CONFIG_DIR}"
    log "执行：${setup_cmd}"

    if ! bash -c "${setup_cmd}" >> "${INSTALL_LOG}" 2>&1; then
        fail "moviepilot setup 执行失败，详见 ${INSTALL_LOG}"
    fi
    log "setup 完成"
}

# --------------------------------------------------------------------------
# 修正属主
# install 脚本以 root 运行；cmd/main 以 moviepilot 用户运行，需保证可读写。
# --------------------------------------------------------------------------
fix_ownership() {
    log "=== 修正文件属主 ==="
    # DATA_DIR (TRIM_PKGVAR) 下含 MoviePilot ROOT、cloakbrowser-cache、日志等，
    # 运行时全部由 moviepilot 用户读写，整体 chown 最稳妥。
    chown -R "${APP_USER}:${APP_GROUP}" "${DATA_DIR}" 2>/dev/null || \
        log "[WARN] chown ${DATA_DIR} 失败（可能权限受限）"
    chown -R "${APP_USER}:${APP_GROUP}" "${CONFIG_DIR}" 2>/dev/null || \
        log "[WARN] chown ${CONFIG_DIR} 失败"
    log "属主修正完成：${APP_USER}:${APP_GROUP}"
}

# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------
preflight
probe_github_mirror
deploy_source
setup_node_symlinks
write_env_file
run_setup
fix_ownership

log "=== MoviePilot 安装完成 ==="
log "访问：http://<NAS-IP>:3000  账号：${SUPERUSER}（首次登录请改密）"
log "配置目录：${CONFIG_DIR}"
exit 0
